[Unit]
Description=ASUS Power Controller EPP monitor
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/lib/asus-power-controller/epp.py
DynamicUser=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
Restart=on-failure

[Install]
WantedBy=multi-user.target
